{
  "name": "agentflow-ai",
  "version": "1.0.0",
  "description": "Agentic AI Automation Platform (Agentflow_AI)",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "start": "concurrently \"npm --prefix server start\" \"npm --prefix client start\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "author": "Agentflow AI Team",
  "license": "MIT"
}
